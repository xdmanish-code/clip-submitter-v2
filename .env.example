# =====================================================================
# CLIP SUBMITTER V2 — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and customize the values for your setup.
# =====================================================================

# ---------------------------------------------------------------------
# SERVER & DASHBOARD CONFIGURATION
# ---------------------------------------------------------------------
# Web dashboard & API port (default: 4000)
PORT=4000

# Authentication secret for WebSocket connection between agent and backend
AGENT_TOKEN=local-agent-secret

# ---------------------------------------------------------------------
# SUBMISSION PLATFORM TARGETS
# ---------------------------------------------------------------------
# Cleanframe Dashboard URL (for Dual mode queue scanning & status sync)
WEBSITE_URL=https://your-cleanframe-instance.workers.dev/

# Discord channel for Dual /submit slash commands
DISCORD_URL=https://discord.com/channels/YOUR_SERVER_ID/YOUR_CHANNEL_ID

# Discord channel for Kick clipping bot slash commands
KICK_DISCORD_URL=https://discord.com/channels/YOUR_SERVER_ID/YOUR_CHANNEL_ID

# ---------------------------------------------------------------------
# EXECUTION & SAFETY CONTROLS
# ---------------------------------------------------------------------
# Safe test mode: when true, actions run and verify without final commit/submit.
# Set to false ONLY when ready to execute live submissions.
DRY_RUN=true

# Max wait time (ms) for Discord/target UI DOM element state changes
UI_TIMEOUT_MS=12000

# Inter-keystroke / search delay (ms) for autocomplete lookups
SEARCH_DELAY_MS=900

# ---------------------------------------------------------------------
# BROWSER & REMOTE DEBUGGING
# ---------------------------------------------------------------------
# Port for Chrome/Edge/Brave remote debugging CDP connection (default: 9222)
BROWSER_PORT=9222

# Optional custom browser executable path (uncomment to override auto-discovery)
# Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
# macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux:   /usr/bin/google-chrome
# CHROME_PATH=
